version: 1

# General Database Options @ https://linux.die.net/man/5/slapd-config

dn: olcDatabase={1}mdb,cn=config
changetype: modify
########################
# configure ACLs
########################
replace: olcAccess
# The frontend ACL determines effective Root DSE visibility before slapd reaches
# this backend. Keep this rule first because provider bootstrap inserts its
# replication access rule at {1}, ahead of the attribute restrictions below.
olcAccess: {0}to dn.base=""
  by * read
olcAccess: {1}to attrs=shadowLastChange
  by self write
  by users read
  by * none
olcAccess: {2}to attrs=userPassword
  by dn="${LDAP_INIT_ROOT_USER_DN}" write
  by group/groupOfUniqueNames/uniqueMember="${LDAP_INIT_ADMIN_GROUP_DN}" write
  by group/groupOfUniqueNames/uniqueMember="${LDAP_INIT_PASSWORD_RESET_GROUP_DN}" write
  by self write
  by anonymous auth
  by * none
olcAccess: {3}to attrs=sshPublicKey
  by dn="${LDAP_INIT_ROOT_USER_DN}" write
  by group/groupOfUniqueNames/uniqueMember="${LDAP_INIT_ADMIN_GROUP_DN}" write
  by group/groupOfUniqueNames/uniqueMember="${LDAP_INIT_PASSWORD_RESET_GROUP_DN}" write
  by self write
  by users read
  by * none
olcAccess: {4}to *
  by dn="${LDAP_INIT_ROOT_USER_DN}" write
  by group/groupOfUniqueNames/uniqueMember="${LDAP_INIT_ADMIN_GROUP_DN}" write
  by users read
  by anonymous auth
  by * none
