#See https://docs.docker.com/compose/env-file/

#INIT_SH_FILE=

LDAP_INIT_ORG_DN=DC=example,DC=com
LDAP_INIT_ORG_NAME=Example Inc
#LDAP_INIT_ADMIN_GROUP_DN=cn=ldap-admins,ou=Groups,DC=example,DC=com
#LDAP_INIT_ROOT_USER_DN=uid=admin,DC=example,DC=com
LDAP_INIT_ROOT_USER_PW=password

#LDAP_INIT_PPOLICY_DEFAULT_DN=cn=DefaultPasswordPolicy,ou=Policies,DC=example,DC=com
LDAP_INIT_PPOLICY_PW_MIN_LENGTH=8
#LDAP_INIT_PPOLICY_MAX_FAILURES=3
#LDAP_INIT_PPOLICY_LOCKOUT_DURATION=300
#LDAP_INIT_RFC2307BIS_SCHEMA=0
# The image converts this legacy rule to Debian PPM on every writer start.
# An empty value disables normal updates. During migration from pqChecker, the image still adds missing defaults.
#LDAP_PPOLICY_PQCHECKER_RULE=0|01010101
# Native PPM text overrides the legacy rule. An empty value disables automatic updates.
# Use Compose YAML or INIT_SH_FILE for multiple lines.
#LDAP_PPOLICY_PPM_CONFIG=minQuality 3

# Replication is configured only when a new config volume is initialized.
#LDAP_INIT_REPLICATION_ROLE=provider
# The provider URI is configured only on a consumer.
#LDAP_INIT_REPLICATION_PROVIDER_URI=ldaps://provider
# Defaults to /run/secrets/ldap-replication-password when a role is selected.
#LDAP_INIT_REPLICATION_BIND_PASSWORD_FILE=/run/secrets/custom-replication-password

#LDAP_NOFILE_LIMIT=1024
#LDAP_LOG_LEVELS=Config Stats

# Format is "HH:MM", i.e. 24-hour format with minute precision
#LDAP_BACKUP_TIME=02:00
# Use a Unix-permission-aware parent writable by openldap but protected from other UIDs.
#LDAP_BACKUP_FILE=/var/lib/ldap/data.ldif
